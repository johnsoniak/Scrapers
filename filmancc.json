{
  "id": "filmancc",
  "name": "Filman.cc",
  "version": "1.4",
  "description": "Filman.cc z lazy-resolve: wyszukuje i listuje zrodla bez zuzywania limitow, a lancuch routeToken -> /link/token -> tmp-url.pro (XOR) rozwiazuje natywny resolver dopiero po wybraniu linku w playerze.",
  "baseUrl": "https://filman.cc",
  "language": "pl",
  "types": ["movies", "series"],
  "nsfw": false,
  "priority": 10,
  "enabledByDefault": true,
  "cf": true,
  "category": "portal",
  "moduleType": "scraper",
  "runtime": {
    "enabled": true
  },
  "settings": [
    {
      "key": "username",
      "label": "Login",
      "type": "text",
      "required": true,
      "placeholder": "Twoj login na filman.cc",
      "group": "Konto"
    },
    {
      "key": "password",
      "label": "Haslo",
      "type": "password",
      "required": true,
      "placeholder": "Twoje haslo na filman.cc",
      "sensitive": true,
      "group": "Konto"
    }
  ],
  "auth": {
    "type": "login",
    "loginUrl": "/logowanie",
    "usernameField": "login",
    "passwordField": "password",
    "username": "{settings.username}",
    "password": "{settings.password}",
    "fields": {
      "remember": "on",
      "submit": ""
    },
    "csrf": {
      "url": "/logowanie",
      "selector": "input[name=_csrf] | attr:value",
      "field": "_csrf"
    },
    "verify": {
      "url": "/android-apk",
      "loggedIn": "yloguj"
    }
  },
  "errorDetection": [
    {
      "id": "cloudflare",
      "detectIn": "body",
      "contains": "cf-browser-verification",
      "response": {
        "error": "CLOUDFLARE_CHALLENGE",
        "message": "Wymagane rozwiazanie Cloudflare.",
        "requiresWebView": true,
        "url": "{baseUrl}"
      }
    },
    {
      "id": "login_page_title",
      "detectIn": "body",
      "contains": "<title>Logowanie",
      "response": {
        "error": "LOGIN_REQUIRED",
        "message": "Filman zwrocil strone logowania. Sprawdz login i haslo w ustawieniach scrapera.",
        "requiresWebView": true,
        "url": "{baseUrl}/logowanie"
      }
    },
    {
      "id": "login_page_url",
      "detectIn": "body",
      "contains": "og:url\" content=\"http://filman.cc/logowanie",
      "response": {
        "error": "LOGIN_REQUIRED",
        "message": "Filman zwrocil strone logowania. Ciasteczka sa niepoprawne, wygasle albo nie pasuja do fingerprintu przegladarki.",
        "requiresWebView": true,
        "url": "{baseUrl}/logowanie"
      }
    }
  ],
  "search": {
    "url": "/search",
    "method": "GET",
    "params": {
      "phrase": "{title}"
    },
    "headers": {
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8",
      "Accept-Language": "pl,en-US;q=0.7,en;q=0.3",
      "DNT": "1",
      "Referer": "{baseUrl}/",
      "Upgrade-Insecure-Requests": "1",
      "User-Agent": "FilmanKodi/1.0 (compatible; Firefox/146.0)"
    },
    "responseType": "html",
    "resultSelector": {
      "container": "div.col-xs-6:has(div.poster)",
      "fields": {
        "title": "div.poster img | attr:alt",
        "url": "div.poster a | href",
        "year": ".film_year | text",
        "thumbnail": "div.poster img | attr:data-src"
      }
    }
  },
  "matching": {
    "titleField": "title",
    "yearField": "year",
    "urlField": "url",
    "yearTolerance": 1,
    "scoring": {
      "minScore": 70
    }
  },
  "detail": {
    "url": "{result.url}",
    "headers": {
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8",
      "Accept-Language": "pl,en-US;q=0.7,en;q=0.3",
      "DNT": "1",
      "Upgrade-Insecure-Requests": "1",
      "User-Agent": "FilmanKodi/1.0 (compatible; Firefox/146.0)",
      "Referer": "{baseUrl}/search?phrase={title}"
    }
  },
  "episode": {
    "url": "{result.url}",
    "container": "a:matchesOwn(\\[s\\d+e\\d+\\]), a[href*=\"/odcinek\"], a[href*=\"/e/\"]",
    "urlField": "| href",
    "labelField": "| text",
    "pattern": "s(\\d+)e(\\d+)"
  },
  "sources": {
    "extract": [
      {
        "type": "css",
        "selector": "table#links tr:has(a[data-id])",
        "fields": {
          "dataId": "a | attr:data-id",
          "hosting": "img | attr:alt",
          "version": "td:nth-child(2) | text",
          "quality": "td:nth-child(3) | text"
        }
      }
    ],
    "output": {
      "url": "filmancc-lazy://resolve?dataId={dataId}&page={result.url}",
      "hosting": "{hosting}",
      "version": "{version}",
      "quality": "{quality}",
      "type": "pl",
      "language": "pl"
    }
  }
}
