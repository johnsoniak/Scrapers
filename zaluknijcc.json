{
  "id": "zaluknijcc",
  "name": "Zaluknij.cc",
  "version": "1.0.2",
  "description": "Scraper JSON do zaluknij.cc. Selektory zgodne z dzialajacym scraperem: #advanced-search .col-sm-*, video-card. Cloudflare rozwiazywany przez WebView (snapshot).",
  "baseUrl": "https://zaluknij.cc",
  "language": "pl",
  "types": ["movies", "series"],
  "nsfw": false,
  "priority": 10,
  "enabledByDefault": true,
  "cf": true,
  "category": "portal",
  "moduleType": "scraper",
  "runtime": {
    "enabled": true
  },
  "search": {
    "url": "/wyszukiwarka",
    "method": "GET",
    "params": {
      "phrase": "{title}"
    },
    "headers": {
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8",
      "Accept-Language": "pl,en-US;q=0.7,en;q=0.3",
      "Referer": "{baseUrl}/",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:146.0) Gecko/20100101 Firefox/146.0"
    },
    "responseType": "html",
    "resultSelector": {
      "container": "#advanced-search div[class*=\"col-sm-\"]:has(a[href]):has(.title)",
      "fields": {
        "title": ".title | text",
        "url": "a | href",
        "year": "a | href",
        "thumbnail": "img | src"
      }
    }
  },
  "matching": {
    "titleField": "title",
    "yearField": "year",
    "urlField": "url",
    "yearTolerance": 1,
    "scoring": {
      "minScore": 70
    }
  },
  "detail": {
    "url": "{result.url}",
    "headers": {
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8",
      "Accept-Language": "pl,en-US;q=0.7,en;q=0.3",
      "Referer": "{baseUrl}/wyszukiwarka?phrase={title}",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:146.0) Gecko/20100101 Firefox/146.0"
    }
  },
  "episode": {
    "url": "{result.url}",
    "container": "#episode-list a[href], ul#episode-list li a[href], a:matchesOwn(s\\d+e\\d+)",
    "urlField": "| href",
    "labelField": "| text",
    "pattern": "s(\\d+)e(\\d+)"
  },
  "sources": {
    "extract": [
      {
        "type": "css",
        "selector": "div.video-card.link-to-video:has(a[href])",
        "fields": {
          "url": "a.stretched-link | href",
          "version": "span.badge-version | text",
          "quality": ".badge-quality | text"
        }
      },
      {
        "type": "css",
        "selector": "#link-list tbody tr:has(a[href]), table tbody tr:has(a[href])",
        "fields": {
          "url": "a | href",
          "version": "td:nth-child(3) | text",
          "quality": "td:nth-child(4) | text"
        }
      }
    ],
    "transform": [
      {
        "field": "quality",
        "type": "map",
        "values": {
          "wysoka": "720p",
          "średnia": "720p",
          "srednia": "720p",
          "niska": "CAM"
        },
        "default": "SD"
      }
    ],
    "output": {
      "url": "{url}",
      "version": "{version}",
      "quality": "{quality}",
      "type": "pl",
      "language": "pl"
    }
  }
}
